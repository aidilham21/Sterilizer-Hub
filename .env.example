# ==============================================================================
# Sterilizer Hub - Environment Configuration Template
# Salin file ini menjadi `.env` dan sesuaikan nilainya untuk lingkungan Anda:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# Flask Server Configuration
# Hasilkan kunci aman dengan menjalankan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secure_hex_key
FLASK_DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sterilizer_db

# Initial Administrator & Operator Setup
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_OPERATOR_USER=idil
DEFAULT_OPERATOR_PASSWORD=idil123

# Hardware Serial Communication (Arduino / ESP32)
SERIAL_PORT=COM10
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1.0
